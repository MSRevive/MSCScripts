#pragma context shared

// Shared module example
// This script runs on both client and server builds

module SharedUtils {
    // Constructor - automatically called when module loads
    SharedUtils() {
        LogMessage("SharedUtils module initialized (SHARED)");
        MS_ANGEL_INFO("Shared utilities available on both client and server");
    }
    
    // Math utilities - useful on both client and server
    float Clamp(float value, float minVal, float maxVal) {
        if (value < minVal) return minVal;
        if (value > maxVal) return maxVal;
        return value;
    }
    
    float Lerp(float a, float b, float t) {
        return a + (b - a) * Clamp(t, 0.0f, 1.0f);
    }
    
    // Vector utilities
    Vector3 VectorLerp(const Vector3 &in a, const Vector3 &in b, float t) {
        t = Clamp(t, 0.0f, 1.0f);
        return Vector3(
            Lerp(a.x, b.x, t),
            Lerp(a.y, b.y, t),
            Lerp(a.z, b.z, t)
        );
    }
    
    float VectorDistance(const Vector3 &in a, const Vector3 &in b) {
        Vector3 diff = b - a;
        return diff.Length();
    }
    
    Vector3 VectorNormalize(const Vector3 &in v) {
        return v.Normalize();
    }
    
    // String utilities
    string FormatTime(float seconds) {
        int totalSeconds = int(seconds);
        int hours = totalSeconds / 3600;
        int minutes = (totalSeconds % 3600) / 60;
        int secs = totalSeconds % 60;
        
        return hours + "h " + minutes + "m " + secs + "s";
    }
    
    string FormatNumber(int number) {
        string str = "" + number;
        // Add commas for thousands
        // This is a simplified version
        return str;
    }
    
    // Data validation - useful on both sides
    bool IsValidPlayerName(const string &in name) {
        int len = Length(name);
        if (len < 3 || len > 32) {
            return false;
        }
        
        // Check for valid characters (simplified)
        // In a real implementation, you'd check for alphanumeric + specific symbols
        return true;
    }
    
    bool IsValidEmail(const string &in email) {
        // Simplified email validation
        int atPos = -1;
        int dotPos = -1;
        
        for (int i = 0; i < Length(email); i++) {
            // In a real implementation, you'd check character by character
            // This is just a placeholder
        }
        
        return Length(email) > 5; // Simplified
    }
    
    // Random number utilities
    int RandomInt(int minVal, int maxVal) {
        float rand = Random(float(minVal), float(maxVal + 1));
        return int(rand);
    }
    
    bool RandomChance(float probability) {
        return Random(0.0f, 1.0f) < probability;
    }
    
    // Color utilities
    Color ColorLerp(const Color &in a, const Color &in b, float t) {
        t = Clamp(t, 0.0f, 1.0f);
        return Color(
            int(Lerp(float(a.r), float(b.r), t)),
            int(Lerp(float(a.g), float(b.g), t)),
            int(Lerp(float(a.b), float(b.b), t)),
            int(Lerp(float(a.a), float(b.a), t))
        );
    }
    
    Color HSVToRGB(float h, float s, float v) {
        // Simplified HSV to RGB conversion
        // In a real implementation, you'd do proper color space conversion
        return Color(255, 255, 255, 255);
    }
    
    // Array utilities
    int ArraySum(const array<int> &in arr) {
        int sum = 0;
        for (uint i = 0; i < arr.length(); i++) {
            sum += arr[i];
        }
        return sum;
    }
    
    float ArrayAverage(const array<float> &in arr) {
        if (arr.length() == 0) return 0.0f;
        
        float sum = 0.0f;
        for (uint i = 0; i < arr.length(); i++) {
            sum += arr[i];
        }
        return sum / float(arr.length());
    }
    
    // Logging helpers
    void DebugLog(const string &in category, const string &in message) {
        MS_ANGEL_DEBUG("[" + category + "] " + message);
    }
    
    void InfoLog(const string &in category, const string &in message) {
        MS_ANGEL_INFO("[" + category + "] " + message);
    }
    
    void ErrorLog(const string &in category, const string &in message) {
        MS_ANGEL_ERROR("[" + category + "] " + message);
    }
}

