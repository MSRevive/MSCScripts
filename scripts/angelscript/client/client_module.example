#pragma context client

// Client-side module example
// This script can only run on the client build

module ClientExample {
    private bool hudVisible = true;
    private float hudOpacity = 1.0f;
    
    // Constructor - automatically called when module loads
    ClientExample() {
        LogMessage("ClientExample module initialized on CLIENT");
        MS_ANGEL_INFO("Client-side initialization complete");
    }
    
    // Client-only functionality - UI management
    void ShowNotification(const string &in title, const string &in message) {
        MS_ANGEL_INFO("Showing notification: " + title);
        // In a real implementation, this would create UI elements
        LogMessage("[NOTIFICATION] " + title + ": " + message);
    }
    
    void UpdateHUD() {
        if (!hudVisible) return;
        
        // In a real implementation, this would update HUD elements
        // Using client-side data like local player position, health, etc.
        MS_ANGEL_DEBUG("Updating HUD...");
    }
    
    void ToggleHUD() {
        hudVisible = !hudVisible;
        MS_ANGEL_INFO("HUD " + (hudVisible ? "shown" : "hidden"));
    }
    
    void SetHUDOpacity(float opacity) {
        hudOpacity = Clamp(opacity, 0.0f, 1.0f);
        MS_ANGEL_INFO("HUD opacity set to: " + hudOpacity);
    }
    
    // Client-only: Visual effects
    void PlayEffect(const string &in effectName, const Vector3 &in position) {
        MS_ANGEL_INFO("Playing effect '" + effectName + "' at position: " + 
                     position.x + ", " + position.y + ", " + position.z);
        // In a real implementation, this would trigger particle effects, sounds, etc.
    }
    
    void PlaySound(const string &in soundName) {
        MS_ANGEL_INFO("Playing sound: " + soundName);
        // In a real implementation, this would play audio
    }
    
    // Client-only: Input handling
    void OnKeyPress(const string &in key) {
        MS_ANGEL_DEBUG("Key pressed: " + key);
        
        if (key == "F1") {
            ToggleHUD();
        } else if (key == "F2") {
            ShowNotification("Help", "Press F1 to toggle HUD");
        }
    }
    
    // Client-only: Camera control
    void SetCameraFOV(float fov) {
        fov = Clamp(fov, 60.0f, 120.0f);
        MS_ANGEL_INFO("Camera FOV set to: " + fov);
        // In a real implementation, this would adjust the camera
    }
    
    // Helper function - can use shared functions
    float Clamp(float value, float minVal, float maxVal) {
        if (value < minVal) return minVal;
        if (value > maxVal) return maxVal;
        return value;
    }
}

