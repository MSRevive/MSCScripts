//Gib burst by greatguys1
//Overhauled September2018 so it's not garbage
//Params:
//<origin> <model_name;model_name> <submodel;submodel> <render_props> <amt> <force> <duration>

#scope client

{
	//const GIB_MODEL none //[model name] Which gib model to use
	//const GIB_FORCE_SUBMODEL none //[idx] Force a submodel; don't override if you wish to use random submodels
	//const GIB_SUBMODELS none //[num] How many submodels does it have to choose from randomly. Not needed if forcing a submodel

	const GIB_BOUNCE_FACTOR 1.3 //[0-1] A float of the bounce multiplier.
	const GIB_GRAV 0.7 //[num] Multiplier for gravity, 1 is normal.
	const GIB_COLLISION "world" //["world"|"all"|"none"] What to collide with.
	const GIB_DIE_ON_COLLIDE 0 //[0|1] Die on collision? Must also be used with "world" or "all".
	const GIB_RENDER_FX "normal" //["normal"|"glow"|"player"] --------------------------^
	//const GIB_COLOR 0 //(r,g,b) color
}

{ client_activate //<origin> <model_name;model_name> <submodel;submodel> <render_props> <amt> <force> <duration> //fuck me thats a lot of params
	//For PARAM2, providing additional model names in a token will make this script randomly choose one
	//For PARAM3, providing additional submodel indexes in a token will make this script randomly choose one
	//render props format: fadeout:0|1;scale;renderamt;rendermode

	setvard FX_ORIGIN PARAM1
	setvard FX_MODELS PARAM2
	setvard FX_SUBMODELS PARAM3
	setvard FX_RENDER_PROPS PARAM4
	setvard FX_AMT PARAM5
	setvard FX_FORCE PARAM6
	setvard FX_DURATION PARAM7

	callevent 0.01 start_gibs //Slight delay so I can override the setvards in client_activate on a higher script.

	callevent FX_DURATION remove_me
}

{ start_gibs

	calleventloop FX_AMT create_gibs
}

{ create_gibs

	cleffect tempent model $get_random_token(FX_MODELS) FX_ORIGIN setup_gib update_gib
}

{ setup_gib

	local L_PITCH $rand(0,359)
	local L_YAW $rand(0,359)
	local L_ROLL $rand(0,359)

	local L_ANG $vec(L_PITCH,L_YAW,0)
	
	//PARAMS Passed
	//Submodel
	cleffect tempent set_current_prop body $get_random_token(FX_SUBMODELS)

	//Duration
	cleffect tempent set_current_prop death_delay	FX_DURATION

	//Renderprops
	if ( $get_token(FX_RENDER_PROPS,0) == 1 ) cleffect tempent set_current_prop fadeout lifetime
	cleffect tempent set_current_prop scale		$get_token(FX_RENDER_PROPS,1)
	cleffect tempent set_current_prop renderamt	$get_token(FX_RENDER_PROPS,2)
	cleffect tempent set_current_prop rendermode	$get_token(FX_RENDER_PROPS,3)

	//Force
	cleffect tempent set_current_prop velocity $relvel($vec($rand(0,359),$rand(0,90),0),FX_FORCE) //I wanna throw this independent of the actual angs, 'cuz I don't wanna throw it at the ground

	//Others
	cleffect tempent set_current_prop bouncefactor	GIB_BOUNCE_FACTOR
	cleffect tempent set_current_prop gravity	GIB_GRAV

	cleffect tempent set_current_prop renderfx	GIB_RENDER_FX	

	cleffect tempent set_current_prop collide	GIB_COLLISION
	

	if ( GIB_DIE_ON_COLLIDE )
	{
		cleffect tempent set_current_prop collide "die"
	}

	cleffect tempent set_current_prop angles L_ANG //A bug appears to select a random angle again after hitting the ground. Still works out ok though.
}

{ update_gib
	
}

{ remove_me
	removescript
}