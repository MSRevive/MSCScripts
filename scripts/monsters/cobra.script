//Cobra
//Thothie - increased ATTACK_RANGE to match ATTACK_HITRANGE 
// - increased size to 64x64
// - Added poison effect of Fangtooth (95%) - 5-10 damage
// - Also added a few more HP
// - Figure doesnt attack unless attacked first, so midas well be a bit meaner
{
    const SOUND_ALERT monsters/gsnake_idle1.wav
	const SOUND_IDLE monsters/gsnake_idle1.wav
	const SOUND_ATTACK bullchicken/bc_bite2.wav
	const SOUND_STRUCK debris/flesh3.wav
	const SOUND_PAIN1 agrunt/ag_attack3.wav
	const SOUND_PAIN2 agrunt/ag_idle2.wav
	const SOUND_DEATH agrunt/ag_die2.wav
	setvar ATTACK_HITCHANCE 95%
	setvar ANIM_RUN walk
	setvar ANIM_IDLE idle1
	setvar ANIM_WALK walk
	setvard ANIM_DEATH diesimple
	setvard ANIM_ATTACK attack1
	setvar ATTACK1_DAMAGE 45
	setvard ATTACK_RANGE 230
	setvard ATTACK_HITRANGE 230
	setvard MOVE_RANGE 64

	const DMG_POISON $randf(10,15)
}

#include monsters/base_monster

{ npc_spawn

	hp 200/200
	//ov 359
	width 64
	height 64
	race demon //for ease of placement
	name Cobra
	roam 0
	setvard NPC_GIVE_EXP 100
	setmodel monsters/kcobra.mdl
	setidleanim idle1
	setmoveanim idle1
	playanim once idle1
	hearingsensitivity 5
}
                                            
{ attack1

   dodamage ENTITY_ENEMY ATTACK_RANGE ATTACK1_DAMAGE 75%

   if( $rand(1,3) == 1 ) applyeffect ent_lastseen effects/dot_poison 15 $get(ent_me,id) DMG_POISON 
   
   playsound 0 10 SOUND_ATTACK
}

{ game_struck

	playrandomsound 0 10 SOUND_PAIN1 SOUND_PAIN2 SOUND_STRUCK SOUND_STRUCK SOUND_ATTACK
}

{ npcatk_targetvalidate

	if $get(PARAM1,isalive)
	if $get(PARAM1,relationship,ent_me) equals enemy

	if !DID_ALERT
	playsound 0 10 SOUND_ALERT
	setvard DID_ALERT 1
}

{ idle_sounds

	playsound 0 10 SOUND_IDLE
	callevent $randf(5,10) idle_sounds	
}