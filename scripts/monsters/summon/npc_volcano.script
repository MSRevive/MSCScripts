//Thothie - Reduced level of Volcano to something obtainable
//Thothie - No parameters other than owner are passing to this monster for some reason
//- Reducing damage as well
//- PARAM1 = owner
//Volcano
#scope server

{
	const SOUND_START	magic/volcano_start.wav
	const SOUND_LOOP	magic/volcano_loop.wav
	const MODEL_WORLD	misc/volcano.mdl
	setvard ANIM_DEATH down	//for base_npc
	setvard I_DO_FIRE_DAMAGE 1

	const ANGLE_OFFSET 60 //Max angle offset the fireball can shoot
	const FORCE_OFFSET 70 //Force of the projectile +/- a random range of this amount


  	precache misc/volcano.mdl
	precache SOUND_START
	precache SOUND_LOOP
	precache fire1_fixed.spr
	precache rain_mist.spr
	precache weapons/projectiles.mdl

}

{ [shared]
	const ROCK_START_HEIGHT 66
}

#include monsters/base_npc

{  
   eventname npc_spawn

   hp 1500
   invincible 1 //screw it, it has 1500pts anyways - and ya don't want it to report attacks against itself
   setsolid none //doesnt trap monsters/players inside of it
   fov 90
   width 32
   height 64
   name A Volcano
   roam 0
   takedmg cold 2.0
   takedmg fire 0.0
   skilllevel 0
   hearingsensitivity 0
   setmodel MODEL_WORLD
   blood none
   setstat spellcasting 15 15 15
   playanim hold up
   callevent 2 volcano_start  		//Start erupting after a delay
   effect screenshake $relpos(0,0,0) 50 10 6 512
   playsound 0 7 SOUND_START
}

{ game_dynamically_created

	//$get(ent_me,id) 300 SPELL_FREQ

	setvard DMG_HIGH PARAM2
	setvard DMG_LOW 25 //never set, so rolls started at 0
	setvard TIME_LIVE PARAM3 //Seconds to live
	setvard LOOP_DELAY 0

   callevent TIME_LIVE volcano_death  	//Die after a delay
   clientevent new all $currentscript $get(ent_me,index) TIME_LIVE
   setvard VOLCANO_ID game.script.last_sent_id
   //emitsound ent_me $get(ent_me,origin) 512 TIME_LIVE danger 512

   //This seems to be giving skill points - but to no paticular skill (keep leveling up null)
   //debugprint ParAtCreate PARAM1
   
   storeentity ent_expowner PARAM1	//Give any gained exp to the player
}

// Start shooting
{
   eventname volcano_start
   setvard ERUPTING 1
   clientevent update all VOLCANO_ID fx_start
}

// Random shoot rock
{
   repeatdelay $randf(0.0,0.5)
   
   if ERUPTING
   callevent volcano_shoot
}
{
   repeatdelay $randf(0.0,0.5)
   
   if ERUPTING
   callevent volcano_shoot
}

// Shoot rock
{
   eventname volcano_shoot

   local ATTACK_DAMAGE $randf(DMG_LOW,DMG_HIGH)

   //Target pos, not view angles - view pitch is inverted and these were
   //firing into the ground. Same as summon_volcano.
   local L_ORIGIN $relpos(0,0,ROCK_START_HEIGHT)
   local L_DIR L_ORIGIN
   vectoradd L_DIR z 50
   vectoradd L_DIR x $math(multiply,ANGLE_OFFSET,$randf(-1,1))
   vectoradd L_DIR y $math(multiply,ANGLE_OFFSET,$randf(-1,1))

   local L_FORCE 500
   add L_FORCE $math(multiply,FORCE_OFFSET,$randf(-1,1))

   //<projectile scriptname> <"view"|(src_origin)> <target|(targ_origin)|none> <speed> <damage> <cof> <skill|none> //Converted to use new tossprojectile //greatguys1@FEB2022
   tossprojectile "proj_volcano" L_ORIGIN L_DIR L_FORCE ATTACK_DAMAGE 0 none

   //extra red rocks for show, own arcs clientside
   clientevent update all_in_sight VOLCANO_ID volcono_shoot_rock
}

// Fade out
{ volcano_death

   setvard ERUPTING 0
   clientevent update all VOLCANO_ID fx_end

   playanim hold down
   callevent 3 volcano_fadeout
}

{
   eventname volcano_fadeout
   playsound CHAN_BODY game.sound.silentvol SOUND_LOOP
   deleteent ent_me fade
}

//Client-side
//===========
//Same fx as the player cast, see monsters/summon/summon_volcano

{  [client]
	const CL_MODEL_WORLD	weapons/projectiles.mdl
	const SPRITE_BURN	fire1_fixed.spr
	const SPRITE_SMOKE	rain_mist.spr
	const FLAME_CIRCLE_BODY	51

	const ROCK_GLOW		(255,0,0) //red, tells enemy rocks from player ones
	const ROCK_LIGHT_RAD	64
	const ROCK_LIGHT_DUR	0.8
	const ROCK_SPREAD	170 //sideways scatter on the fake rocks
	const ROCK_FORCE_MIN	380
	const ROCK_FORCE_MAX	560

	const CHAN_VOLCANO	7
	const LIGHT_RADIUS	250
	const LIGHT_COLOR	(255,100,100)
}

{ [client] client_activate //PARAM1 = idx, PARAM2 = duration

	setvard MODEL_IDX PARAM1
	setvard FX_DURATION PARAM2
	setvard FX_DELAY 0.5
	setvard FX_ACTIVE 0

	callevent FX_DURATION fx_end

	callevent func_rockspawn
	sound.play3d SOUND_START 7 FUNC_ROCKSPAWN_ORIGIN 0.8 CHAN_VOLCANO
}

{ [client] fx_start

	setvard FX_ACTIVE 1
	setvard FX_DELAY 0.2

	cleffect tempent model CL_MODEL_WORLD $getcl(MODEL_IDX,origin) setup_flame_circle update_flame_circle

	callevent func_rockspawn
	cleffect light new FUNC_ROCKSPAWN_ORIGIN LIGHT_RADIUS LIGHT_COLOR FX_DURATION

	callevent 6 loop_sfx
}

{ [client] loop_sfx

	if FX_ACTIVE
	callevent func_rockspawn
	sound.play3d SOUND_LOOP 7 FUNC_ROCKSPAWN_ORIGIN 0.8 CHAN_VOLCANO
	callevent 6 loop_sfx
}

{ [client]
	repeatdelay FX_DELAY
	if ( FX_ACTIVE )
	{
		callevent func_rockspawn
		cleffect tempent sprite SPRITE_BURN FUNC_ROCKSPAWN_ORIGIN volcano_fire_create
	}
	else
	{
		callevent func_rockspawn
		cleffect tempent sprite SPRITE_SMOKE FUNC_ROCKSPAWN_ORIGIN setup_smoke update_smoke
	}
}

{ [client] volcano_fire_create

	cleffect tempent set_current_prop death_delay	1.7
	cleffect tempent set_current_prop velocity	$vec($randf(-40,40),$randf(-40,40),$randf(230,270))
	cleffect tempent set_current_prop bouncefactor	5
	cleffect tempent set_current_prop scale		0.5
	cleffect tempent set_current_prop gravity	0.5
	cleffect tempent set_current_prop collide	all;die
	cleffect tempent set_current_prop framerate	30
	cleffect tempent set_current_prop frames	23
}

{ [client] setup_flame_circle
	cleffect tempent set_current_prop death_delay FX_DURATION
	cleffect tempent set_current_prop body FLAME_CIRCLE_BODY
	cleffect tempent set_current_prop framerate 0.5
	cleffect tempent set_current_prop sequence 8
	cleffect tempent set_current_prop rendermode add
	cleffect tempent set_current_prop renderamt 100
	cleffect tempent set_current_prop scale 7
	cleffect tempent set_current_prop gravity 0
	cleffect tempent set_current_prop collide none
	cleffect tempent set_current_prop frames 11
	cleffect tempent set_current_prop angles $vec(0,90,0)
	cleffect tempent set_current_prop velocity $vec(0,0,0)
}

{ [client] update_flame_circle
	if ( FX_ACTIVE )
	{
		cleffect tempent set_current_prop origin $getcl(MODEL_IDX,origin)
	}
	else
	{
		cleffect tempent set_current_prop origin $vec(10000,10000,10000)
	}
}

{ [client] setup_smoke
	cleffect tempent set_current_prop death_delay 4
	cleffect tempent set_current_prop framerate $rand(1,2)
	cleffect tempent set_current_prop frames 17
	cleffect tempent set_current_prop bouncefactor 0
	cleffect tempent set_current_prop scale 0.1
	cleffect tempent set_current_prop rendermode add
	cleffect tempent set_current_prop renderamt 240
	cleffect tempent set_current_prop rendercolor (255,170,170)
	cleffect tempent set_current_prop gravity -0.055
	cleffect tempent set_current_prop collide "world;die"
}

{ [client] update_smoke

	if ( $math(subtract,game.time,game.tempent.fuser1) >= 0.1 )
	{
		local L_SCALE $math(add,game.tempent.scale,0.04)
		local L_VEL game.tempent.velocity
		vectoradd L_VEL y $math(subtract,game.tempent.velocity,1)
		vectoradd L_VEL x $math(add,game.tempent.velocity,0.3)

		cleffect tempent set_current_prop scale L_SCALE
		cleffect tempent set_current_prop velocity L_VEL
		cleffect tempent set_current_prop fuser1 game.time
	}
}

{ [client] volcono_shoot_rock

	local L_RX $randf(-ROCK_SPREAD,ROCK_SPREAD)
	local L_RY $randf(-ROCK_SPREAD,ROCK_SPREAD)
	local L_RZ $randf(ROCK_FORCE_MIN,ROCK_FORCE_MAX)

	setvard ROCK_VEL $vec(0,0,0)
	vectoradd ROCK_VEL x L_RX
	vectoradd ROCK_VEL y L_RY
	vectoradd ROCK_VEL z L_RZ

	setvard ROCK_GRAV $randf(0.6,1.0)

	callevent func_rockspawn
	cleffect tempent model CL_MODEL_WORLD FUNC_ROCKSPAWN_ORIGIN volcano_rock_create volcano_rock_update volcano_rock_collide
}

{ [client] volcano_rock_create

	cleffect tempent set_current_prop death_delay 	10
	cleffect tempent set_current_prop velocity 	ROCK_VEL
	cleffect tempent set_current_prop bouncefactor 	0
	cleffect tempent set_current_prop gravity 	ROCK_GRAV
	cleffect tempent set_current_prop collide 	all
	cleffect tempent set_current_prop renderfx 	glow
	cleffect tempent set_current_prop renderamt 	100
	cleffect tempent set_current_prop rendercolor 	ROCK_GLOW
	cleffect light new game.tempent.origin ROCK_LIGHT_RAD ROCK_GLOW ROCK_LIGHT_DUR
	cleffect tempent set_current_prop iuser1 	game.script.last_light_id
}

{ [client] volcano_rock_update

	cleffect light game.tempent.iuser1 game.tempent.origin ROCK_LIGHT_RAD ROCK_GLOW ROCK_LIGHT_DUR
}

{ [client] volcano_rock_collide

	cleffect tempent set_current_prop sprite 	SPRITE_BURN
	cleffect tempent set_current_prop rendermode 	add
	cleffect tempent set_current_prop renderamt 	255
	cleffect tempent set_current_prop death_delay 	1
	cleffect tempent set_current_prop scale 	0.5
	cleffect tempent set_current_prop collide 	all
	cleffect tempent set_current_prop framerate	30
	cleffect tempent set_current_prop frames	23
}

{ [client] fx_end

	setvard FX_ACTIVE 0
	setvard FX_DELAY 0.5
	callevent func_rockspawn
	sound.play3d SOUND_LOOP 0 FUNC_ROCKSPAWN_ORIGIN 0.8 CHAN_VOLCANO
	callevent 6.0 fx_die
}

{ [client] fx_die

	removescript
}

{ [shared] func_rockspawn //returns the origin of fireball spawn

	if ( game.serverside )
	{
		local L_ORIGIN $get(ent_me,origin)
	}
	else
	{
		local L_ORIGIN $getcl(MODEL_IDX,origin)
	}

	vectoradd L_ORIGIN z ROCK_START_HEIGHT

	setvard FUNC_ROCKSPAWN_ORIGIN L_ORIGIN
}
